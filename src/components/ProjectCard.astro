---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { projectSlug } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, summary, stack, cover, status } = project.data;
const slug = projectSlug(project.id);

// Desfase escalonado por columna: la izquierda aparece primero y la derecha 120 ms después
const delay = (index % 2) * 120;
---

<article class="reveal" style={`--delay: ${delay}ms`}>
  <a href={`/proyectos/${slug}`} class="card">
    <div class="cover">
      {cover ? (
        <Image
          src={cover}
          alt={`Captura de ${title}`}
          widths={[480, 800]}
          sizes="(max-width: 900px) 100vw, 50vw"
        />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <div class="dots"><span></span><span></span><span></span></div>
          <span class="cmd">$ {slug}</span>
          <span class="hint">[ captura 16:9 ]</span>
        </div>
      )}
    </div>

    <div class="body">
      <div class="head">
        <h3>{title}</h3>
        {status === "en-desarrollo" && <span class="status">en desarrollo</span>}
      </div>
      <p>{summary}</p>
      <ul class="tags" aria-label="Tecnologías">
        {stack.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
    transition:
      translate 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .card:hover {
    translate: 0 -4px;
    border-color: var(--color-accent);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    color: var(--color-text);
  }

  .cover {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-border);
    background: #0b0d10;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    font-family: var(--font-mono);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .cmd {
    font-size: 15px;
    color: var(--color-accent);
  }

  .hint {
    font-size: 12px;
    color: #6f7785;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 22px 24px;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    margin: 0;
    font-size: 21px;
  }

  .status {
    flex-shrink: 0;
    padding: 4px 8px;
    border: 1px solid #3a3424;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
  }

  p {
    margin: 0;
    font-size: 16px;
    color: #b3bac6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 5px 9px;
    border-radius: 4px;
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>