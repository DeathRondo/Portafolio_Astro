---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects("es");
---

<BaseLayout title="Inicio">
  <section class="hero">
    <p class="hello">&gt; hola, soy</p>
    <h1>Edgardo<span class="cursor" aria-hidden="true">_</span></h1>
    <p class="intro">
      Desarrollador Full-Stack. Construyo sistemas web de punta a punta:
      interfaces en Angular, APIs en Laravel, datos en PostgreSQL y despliegue
      con Docker.
    </p>
    <div class="actions">
      <a href="/proyectos" class="btn btn-primary">Ver proyectos</a>
      <a href="/contacto" class="btn btn-secondary">Contactar</a>
    </div>
  </section>

  <section class="projects">
    <div class="section-head">
      <h2>Proyectos</h2>
      <span>{String(projects.length).padStart(2, "0")} en total</span>
    </div>
    <div class="project-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 820px;
    margin-bottom: 96px;
  }

  .hello {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .cursor {
    color: var(--color-accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .intro {
    margin: 0;
    max-width: 640px;
    font-size: 22px;
    color: var(--color-text-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
  }

  h2 {
    margin: 0;
    font-size: 28px;
  }

  .section-head span {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero {
      margin-bottom: 64px;
    }

    .intro {
      font-size: 18px;
    }

    .actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>